{
    "version": "1.14.3-reF1nd",
    "description": "sing-box reF1nd build",
    "homepage": "https://github.com/reF1nd/sing-box-releases",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v1.14.3-reF1nd/sing-box-1.14.3-reF1nd-windows-amd64v3.zip",
            "extract_dir": "sing-box-1.14.3-reF1nd-windows-amd64v3"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config\")) {",
        "    New-Item -ItemType Directory -Path \"$persist_dir\\config\" -Force | Out-Null",
        "}",
        "$managerWrapper = Join-Path $dir 'sing-box-manage.ps1'",
        "$wrapperScript = @'",
        "$ErrorActionPreference = 'Stop'",
        "$scoopRoot = Split-Path (Split-Path (Split-Path $PSScriptRoot -Parent) -Parent) -Parent",
        "$manager = Join-Path $scoopRoot 'persist\\sing-box\\sing-box.ps1'",
        "if (!(Test-Path -LiteralPath $manager -PathType Leaf)) {",
        "    throw \"sing-box management script not found: $manager. Reinstall or update sing-box.\"",
        "}",
        "& $manager @args",
        "'@",
        "Set-Content -LiteralPath $managerWrapper -Value $wrapperScript -Encoding UTF8"
    ],
    "post_install": [
        "$ruleName = 'sing-box Scoop'",
        "$exePath = \"$original_dir\\sing-box.exe\"",
        "$script = @\"",
        "Get-NetFirewallRule -DisplayName '$ruleName' -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue",
        "New-NetFirewallRule -DisplayName '$ruleName' -Direction Inbound -Program '$exePath' -Action Allow -Profile Any | Out-Null",
        "\"@",
        "try {",
        "    $firewallSetup = Start-Process powershell.exe -Verb RunAs -Wait -PassThru -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $script -ErrorAction Stop",
        "    if ($firewallSetup.ExitCode -ne 0) { warn \"sing-box firewall setup exited with $($firewallSetup.ExitCode); setup can be retried manually.\" }",
        "} catch {",
        "    warn \"sing-box firewall setup skipped: $($_.Exception.Message)\"",
        "}",
        "$scriptPath = Join-Path $persist_dir 'sing-box.ps1'",
        "$scriptContent = @'",
        "# Self-Use sing-box task manager v5",
        "[CmdletBinding()]",
        "param(",
        "    [Parameter(Position=0)]",
        "    [ValidateSet('install', 'uninstall', 'start', 'stop', 'restart', 'status')]",
        "    [string]$Action = 'status',",
        "    [string]$ValidationExe = ''",
        ")",
        "",
        "$ErrorActionPreference = 'Stop'",
        "$TaskName = 'sing-box'",
        "$TaskPath = '\\'",
        "$PersistDir = $PSScriptRoot",
        "$ScoopRoot = Split-Path (Split-Path $PersistDir -Parent) -Parent",
        "$ExePath = Join-Path $ScoopRoot 'apps\\sing-box\\current\\sing-box.exe'",
        "$ConfigPath = Join-Path $PersistDir 'config\\config.json'",
        "",
        "function Test-Administrator {",
        "    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()",
        "    $principal = [Security.Principal.WindowsPrincipal]::new($identity)",
        "    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "}",
        "",
        "function Invoke-ElevatedManagementAction {",
        "    $escapedScript = $PSCommandPath.Replace(\"'\", \"''\")",
        "    $escapedValidationExe = $ValidationExe.Replace(\"'\", \"''\")",
        "    $logDir = Join-Path $PersistDir 'logs'",
        "    New-Item -ItemType Directory -Force -Path $logDir | Out-Null",
        "    $outputFile = Join-Path $logDir ('manage-' + [guid]::NewGuid().ToString('N') + '.log')",
        "    $escapedOutput = $outputFile.Replace(\"'\", \"''\")",
        "    # Capture all streams in the elevated process; keep output and exit status visible.",
        "    $command = \"try { & '$escapedScript' -Action '$Action' -ValidationExe '$escapedValidationExe' *> '$escapedOutput'; exit 0 } catch { (`$_ | Out-String) | Out-File -LiteralPath '$escapedOutput' -Encoding UTF8 -Append; exit 1 }\"",
        "    $encodedCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($command))",
        "    $powershell = Join-Path $PSHOME 'powershell.exe'",
        "    if (!(Test-Path -LiteralPath $powershell -PathType Leaf)) {",
        "        $powershell = (Get-Command powershell.exe -ErrorAction Stop).Source",
        "    }",
        "    Write-Host \"Requesting administrator approval for sing-box '$Action'...\"",
        "    try {",
        "        $process = Start-Process -FilePath $powershell -Verb RunAs -ArgumentList @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $encodedCommand) -PassThru -Wait -ErrorAction Stop",
        "        if (Test-Path -LiteralPath $outputFile) {",
        "            Get-Content -LiteralPath $outputFile -Encoding UTF8 | ForEach-Object { Write-Host $_ }",
        "        } else {",
        "            Write-Warning 'Elevated process returned no diagnostic output.'",
        "        }",
        "        if ($process.ExitCode -ne 0) {",
        "            throw \"Elevated sing-box '$Action' failed (exit code $($process.ExitCode)).\"",
        "        }",
        "    } catch {",
        "        throw \"Administrator operation '$Action' failed or was cancelled: $($_.Exception.Message)\"",
        "    } finally {",
        "        Remove-Item -LiteralPath $outputFile -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "",
        "if ($Action -ne 'status' -and !(Test-Administrator)) {",
        "    Invoke-ElevatedManagementAction",
        "    return",
        "}",
        "",
        "function Get-SingBoxTask {",
        "    # Non-admin users might not see tasks registered with the SYSTEM account.",
        "    try {",
        "        $task = Get-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath -ErrorAction Stop",
        "        if ($task) { return $task }",
        "    } catch {",
        "        if (!(Test-Administrator)) {",
        "            throw \"Task '$TaskName' is not visible in this session; administrator verification is required.\"",
        "        }",
        "        $tasks = @(Get-ScheduledTask -TaskPath $TaskPath -ErrorAction Stop)",
        "        return ($tasks | Where-Object { $_.TaskName -eq $TaskName } | Select-Object -First 1)",
        "    }",
        "    if (!(Test-Administrator)) {",
        "        throw \"Task '$TaskName' is not visible in this session; administrator verification is required.\"",
        "    }",
        "    return $null",
        "}",
        "",
        "function Assert-RequiredFiles {",
        "    if (!(Test-Path -LiteralPath $ExePath -PathType Leaf)) {",
        "        throw \"sing-box executable not found: $ExePath\"",
        "    }",
        "    if (!(Test-Path -LiteralPath $ConfigPath -PathType Leaf)) {",
        "        throw \"sing-box config not found: $ConfigPath\"",
        "    }",
        "}",
        "",
        "function Assert-TaskInstalled {",
        "    if (!(Get-SingBoxTask)) {",
        "        throw \"Task '$TaskName' is not installed. Run 'sing-box-manage install' first.\"",
        "    }",
        "}",
        "",
        "function Wait-UntilStopped {",
        "    for ($i = 0; $i -lt 50; $i++) {",
        "        if ((Get-SingBoxTask).State -ne 'Running') { return }",
        "        Start-Sleep -Milliseconds 200",
        "    }",
        "    throw \"Timed out waiting for task '$TaskName' to stop.\"",
        "}",
        "",
        "switch ($Action) {",
        "    'install' {",
        "        $checkExe = $ExePath",
        "        if ($ValidationExe) { $checkExe = $ValidationExe }",
        "        if (Test-Path -LiteralPath $ConfigPath -PathType Leaf) {",
        "            if (!(Test-Path -LiteralPath $checkExe -PathType Leaf)) { throw \"sing-box executable not found: $checkExe\" }",
        "            Write-Host 'Validating sing-box configuration...'",
        "            & $checkExe check -c $ConfigPath",
        "            if ($LASTEXITCODE -ne 0) { throw \"Config check failed (exit code $LASTEXITCODE).\" }",
        "        } else {",
        "            Write-Warning \"Missing $ConfigPath; startup task will be registered but cannot start until a valid config is created.\"",
        "        }",
        "",
        "        # Run the executable directly, not a user-editable PowerShell script, as SYSTEM.",
        "        $taskAction = New-ScheduledTaskAction -Execute $ExePath -Argument ('run -c \"{0}\"' -f $ConfigPath) -WorkingDirectory (Split-Path $ConfigPath -Parent)",
        "        $trigger = New-ScheduledTaskTrigger -AtStartup",
        "        $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest",
        "        $settings = New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1)",
        "        Register-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath -Action $taskAction -Trigger $trigger -Principal $principal -Settings $settings -Description 'Start sing-box as SYSTEM at boot; retry on failure.' -Force | Out-Null",
        "        $registeredTask = Get-SingBoxTask",
        "        if (!$registeredTask) { throw \"Task '$TaskName' could not be found after registration.\" }",
        "        Write-Host \"Verified scheduled task '$TaskName' ($($registeredTask.State)).\"",
        "        Write-Host \"Installed startup task '$TaskName'. Run 'sing-box-manage start' to start now.\"",
        "    }",
        "    'uninstall' {",
        "        $task = Get-SingBoxTask",
        "        if (!$task) {",
        "            Write-Host \"Task '$TaskName' is not installed.\"",
        "        } else {",
        "            if ($task.State -eq 'Running') {",
        "                Stop-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath",
        "                Wait-UntilStopped",
        "            }",
        "            Unregister-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath -Confirm:$false",
        "            Write-Host \"Removed startup task '$TaskName'.\"",
        "        }",
        "    }",
        "    'start' {",
        "        Assert-TaskInstalled",
        "        Start-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath",
        "        Write-Host 'sing-box start requested.'",
        "    }",
        "    'stop' {",
        "        Assert-TaskInstalled",
        "        Stop-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath",
        "        Wait-UntilStopped",
        "        Write-Host 'sing-box stopped.'",
        "    }",
        "    'restart' {",
        "        Assert-TaskInstalled",
        "        if ((Get-SingBoxTask).State -eq 'Running') {",
        "            Stop-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath",
        "            Wait-UntilStopped",
        "        }",
        "        Start-ScheduledTask -TaskName $TaskName -TaskPath $TaskPath",
        "        Write-Host 'sing-box restart requested.'",
        "    }",
        "    'status' {",
        "        try {",
        "            $task = Get-SingBoxTask",
        "            if ($task) {",
        "                $info = Get-ScheduledTaskInfo -TaskName $TaskName -TaskPath $TaskPath -ErrorAction Stop",
        "            }",
        "        } catch {",
        "            if (!(Test-Administrator)) {",
        "                Write-Host 'Unable to query task details without administrator rights; checking with UAC...'",
        "                Invoke-ElevatedManagementAction",
        "                return",
        "            }",
        "            throw",
        "        }",
        "        if (!$task) {",
        "            Write-Host \"Task '$TaskName' is not installed (verified as administrator).\"",
        "        } else {",
        "            $task | Select-Object TaskName, State",
        "            $info | Select-Object LastRunTime, LastTaskResult, NextRunTime",
        "        }",
        "    }",
        "}",
        "'@",
        "$shouldUpdate = !(Test-Path -LiteralPath $scriptPath -PathType Leaf)",
        "if (!$shouldUpdate) {",
        "    $firstLine = Get-Content -LiteralPath $scriptPath -TotalCount 1",
        "    $shouldUpdate = $firstLine -ne '# Self-Use sing-box task manager v5'",
        "    if ($shouldUpdate) {",
        "        $backupPath = \"$scriptPath.bak-$(Get-Date -Format 'yyyyMMdd-HHmmss')\"",
        "        Copy-Item -LiteralPath $scriptPath -Destination $backupPath -ErrorAction Stop",
        "        info \"Previous sing-box manager backed up to $backupPath\"",
        "    }",
        "}",
        "if ($shouldUpdate) { Set-Content -LiteralPath $scriptPath -Value $scriptContent -Encoding UTF8 }",
        "info \"sing-box task manager at $scriptPath (install/uninstall/start/stop/restart/status).\"",
        "$registerArgs = '-NoProfile -ExecutionPolicy Bypass -File \"{0}\" install -ValidationExe \"{1}\"' -f $scriptPath, $exePath",
        "try {",
        "    $registration = Start-Process -FilePath 'powershell.exe' -Verb RunAs -ArgumentList $registerArgs -Wait -PassThru -ErrorAction Stop",
        "    if ($registration.ExitCode -ne 0) { warn \"sing-box task registration failed (exit $($registration.ExitCode)); retry: sing-box-manage install\" }",
        "} catch {",
        "    warn \"sing-box task registration skipped: $($_.Exception.Message). Retry from elevated PowerShell: sing-box-manage install\"",
        "}"
    ],
    "pre_uninstall": [
        "$ruleName = 'sing-box Scoop'",
        "$script = \"Get-NetFirewallRule -DisplayName '$ruleName' -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue\"",
        "Start-Process powershell.exe -Verb RunAs -Wait -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $script"
    ],
    "bin": [
        "sing-box.exe",
        [
            "sing-box-manage.ps1",
            "sing-box-manage"
        ]
    ],
    "persist": "config",
    "checkver": {
        "github": "https://github.com/reF1nd/sing-box-releases",
        "regex": "/releases/tag/v(?<version>\\d+\\.\\d+\\.\\d+-reF1nd(?:\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v$version/sing-box-$version-windows-amd64v3.zip",
                "extract_dir": "sing-box-$version-windows-amd64v3"
            }
        }
    }
}
