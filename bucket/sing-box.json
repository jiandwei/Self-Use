{
    "version": "1.14.3-reF1nd",
    "description": "sing-box reF1nd build",
    "homepage": "https://github.com/reF1nd/sing-box-releases",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v1.14.3-reF1nd/sing-box-1.14.3-reF1nd-windows-amd64v3.zip",
            "extract_dir": "sing-box-1.14.3-reF1nd-windows-amd64v3"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config\")) {",
        "    New-Item -ItemType Directory -Path \"$persist_dir\\config\" -Force | Out-Null",
        "}"
    ],
    "post_install": [
        "$ruleName = 'sing-box Scoop'",
        "$exePath = \"$original_dir\\sing-box.exe\"",
        "$script = @\"",
        "Get-NetFirewallRule -DisplayName '$ruleName' -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue",
        "New-NetFirewallRule -DisplayName '$ruleName' -Direction Inbound -Program '$exePath' -Action Allow -Profile Any | Out-Null",
        "\"@",
        "Start-Process powershell.exe -Verb RunAs -Wait -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $script",
        "$scriptPath = Join-Path $persist_dir 'sing-box.ps1'",
        "if (!(Test-Path -LiteralPath $scriptPath)) {",
        "$scriptContent = @'",
        "param(",
        "    [ValidateSet('start', 'stop', 'restart', 'status')]",
        "    [string]$Action = 'start'",
        ")",
        "",
        "$ErrorActionPreference = 'Stop'",
        "$persistDir = $PSScriptRoot",
        "$appsDir = Split-Path (Split-Path $persistDir -Parent) -Parent",
        "$exe = Join-Path $appsDir 'sing-box\\current\\sing-box.exe'",
        "$config = Join-Path $persistDir 'config\\config.json'",
        "$pidFile = Join-Path $persistDir 'sing-box.pid'",
        "$logDir = Join-Path $persistDir 'logs'",
        "",
        "function Get-ManagedProcess {",
        "    if (!(Test-Path -LiteralPath $pidFile)) { return $null }",
        "    $parts = (Get-Content -LiteralPath $pidFile -Raw).Trim() -split '\\|', 2",
        "    $processId = 0",
        "    if (![int]::TryParse($parts[0], [ref]$processId)) { return $null }",
        "    $process = Get-Process -Id $processId -ErrorAction SilentlyContinue",
        "    if (!$process -or $process.ProcessName -ne 'sing-box') { return $null }",
        "    if ($parts.Count -ne 2) { return $null }",
        "    try {",
        "        if ($process.StartTime.ToUniversalTime().Ticks.ToString() -ne $parts[1]) { return $null }",
        "    } catch { return $null }",
        "    return $process",
        "}",
        "",
        "function Stop-ManagedProcess {",
        "    $process = Get-ManagedProcess",
        "    if ($process) {",
        "        Stop-Process -Id $process.Id -ErrorAction Stop",
        "        $process.WaitForExit(10000) | Out-Null",
        "        if (!$process.HasExited) { throw 'sing-box did not stop within 10 seconds.' }",
        "        Write-Host \"Stopped sing-box (PID $($process.Id)).\"",
        "    } else {",
        "        Write-Host 'sing-box is not running under this script.'",
        "    }",
        "    Remove-Item -LiteralPath $pidFile -Force -ErrorAction SilentlyContinue",
        "}",
        "",
        "switch ($Action) {",
        "    'status' {",
        "        $process = Get-ManagedProcess",
        "        if ($process) { Write-Host \"sing-box is running (PID $($process.Id)).\" }",
        "        else { Write-Host 'sing-box is stopped.' }",
        "    }",
        "    'stop' { Stop-ManagedProcess }",
        "    'restart' {",
        "        Stop-ManagedProcess",
        "        & $PSCommandPath -Action start",
        "        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
        "    }",
        "    'start' {",
        "        $process = Get-ManagedProcess",
        "        if ($process) {",
        "            Write-Host \"sing-box is already running (PID $($process.Id)).\"",
        "            return",
        "        }",
        "        if (!(Test-Path -LiteralPath $exe)) { throw \"sing-box executable not found: $exe\" }",
        "        if (!(Test-Path -LiteralPath $config)) { throw \"Create the sing-box configuration first: $config\" }",
        "        New-Item -ItemType Directory -Force -Path $logDir | Out-Null",
        "        $stdout = Join-Path $logDir 'stdout.log'",
        "        $stderr = Join-Path $logDir 'stderr.log'",
        "        # Start-Process does not accept an arbitrary quoted Windows command line as one argument.",
        "        $arguments = @('run', '-c', ('\"' + $config + '\"'))",
        "        $process = Start-Process -FilePath $exe -ArgumentList $arguments -WorkingDirectory (Split-Path $config -Parent) -WindowStyle Hidden -RedirectStandardOutput $stdout -RedirectStandardError $stderr -PassThru",
        "        Start-Sleep -Milliseconds 500",
        "        $process.Refresh()",
        "        if ($process.HasExited) {",
        "            throw \"sing-box exited immediately (code $($process.ExitCode)); check $stderr\"",
        "        }",
        "        \"$($process.Id)|$($process.StartTime.ToUniversalTime().Ticks)\" | Set-Content -LiteralPath $pidFile -Encoding ASCII",
        "        Write-Host \"Started sing-box (PID $($process.Id)). Logs: $logDir\"",
        "    }",
        "}",
        "'@",
        "Set-Content -LiteralPath $scriptPath -Value $scriptContent -Encoding UTF8",
        "info \"sing-box launcher saved to $scriptPath (start/stop/restart/status).\"",
        "}"
    ],
    "pre_uninstall": [
        "$ruleName = 'sing-box Scoop'",
        "$script = \"Get-NetFirewallRule -DisplayName '$ruleName' -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue\"",
        "Start-Process powershell.exe -Verb RunAs -Wait -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', $script"
    ],
    "bin": "sing-box.exe",
    "persist": "config",
    "checkver": {
        "github": "https://github.com/reF1nd/sing-box-releases",
        "regex": "/releases/tag/v(?<version>\\d+\\.\\d+\\.\\d+-reF1nd(?:\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v$version/sing-box-$version-windows-amd64v3.zip",
                "extract_dir": "sing-box-$version-windows-amd64v3"
            }
        }
    }
}
