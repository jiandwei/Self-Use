{
    "version": "1.14.2-reF1nd",
    "description": "sing-box reF1nd build",
    "homepage": "https://github.com/reF1nd/sing-box-releases",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v1.14.2-reF1nd/sing-box-1.14.2-reF1nd-windows-amd64v3.zip",
            "hash": "7ea7ee15923d064ffb10a5463579f7c64a5c5990c8cfe3309ef0dabba213f4d5",
            "extract_dir": "sing-box-1.14.2-reF1nd-windows-amd64v3"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\config\")) {",
        "    New-Item -ItemType Directory -Path \"$persist_dir\\config\" -Force | Out-Null",
        "}"
    ],
    "post_install": [
        "$ruleName = 'sing-box Scoop'",
        "$taskName = 'sing-box Scoop'",
        "$exePath = \"$original_dir\\sing-box.exe\"",
        "$configPath = \"$persist_dir\\config\\config.json\"",
        "$workDir = \"$persist_dir\\config\"",
        "$tempScript = Join-Path $env:TEMP 'sing-box-scoop-install.ps1'",
        "",
        "$script = @\"",
        "`$ErrorActionPreference = 'Stop'",
        "",
        "# Firewall",
        "Get-NetFirewallRule -DisplayName '$ruleName' -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue",
        "New-NetFirewallRule -DisplayName '$ruleName' -Direction Inbound -Program '$exePath' -Action Allow -Profile Any | Out-Null",
        "",
        "# Remove old scheduled task",
        "Unregister-ScheduledTask -TaskName '$taskName' -Confirm:`$false -ErrorAction SilentlyContinue",
        "",
        "# sing-box action",
        "`$action = New-ScheduledTaskAction `",
        "    -Execute '$exePath' `",
        "    -Argument 'run -c `\"$configPath`\"' `",
        "    -WorkingDirectory '$workDir'",
        "",
        "# Run at Windows startup",
        "`$trigger = New-ScheduledTaskTrigger -AtStartup",
        "",
        "# TUN requires elevated privileges; run as SYSTEM",
        "`$principal = New-ScheduledTaskPrincipal `",
        "    -UserId 'SYSTEM' `",
        "    -LogonType ServiceAccount `",
        "    -RunLevel Highest",
        "",
        "# Long-running task settings",
        "`$settings = New-ScheduledTaskSettingsSet `",
        "    -AllowStartIfOnBatteries `",
        "    -DontStopIfGoingOnBatteries `",
        "    -StartWhenAvailable `",
        "    -RunOnlyIfNetworkAvailable `",
        "    -RestartCount 10 `",
        "    -RestartInterval (New-TimeSpan -Minutes 1) `",
        "    -ExecutionTimeLimit ([TimeSpan]::Zero) `",
        "    -MultipleInstances IgnoreNew",
        "",
        "# Register task",
        "Register-ScheduledTask `",
        "    -TaskName '$taskName' `",
        "    -Action `$action `",
        "    -Trigger `$trigger `",
        "    -Principal `$principal `",
        "    -Settings `$settings `",
        "    -Description 'sing-box TUN auto startup' `",
        "    -Force | Out-Null",
        "\"@",
        "",
        "Set-Content -Path $tempScript -Value $script -Encoding UTF8",
        "$process = Start-Process powershell.exe -Verb RunAs -Wait -PassThru -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ('\"' + $tempScript + '\"')",
        "Remove-Item $tempScript -Force -ErrorAction SilentlyContinue",
        "",
        "if ($process.ExitCode -ne 0) {",
        "    throw \"Failed to configure sing-box scheduled task. Exit code: $($process.ExitCode)\"",
        "}"
    ],
    "pre_uninstall": [
        "$ruleName = 'sing-box Scoop'",
        "$taskName = 'sing-box Scoop'",
        "$tempScript = Join-Path $env:TEMP 'sing-box-scoop-uninstall.ps1'",
        "",
        "$script = @\"",
        "`$ErrorActionPreference = 'SilentlyContinue'",
        "",
        "Stop-ScheduledTask -TaskName '$taskName'",
        "",
        "Get-Process -Name 'sing-box' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
        "",
        "Unregister-ScheduledTask -TaskName '$taskName' -Confirm:`$false -ErrorAction SilentlyContinue",
        "",
        "Get-NetFirewallRule -DisplayName '$ruleName' -ErrorAction SilentlyContinue | Remove-NetFirewallRule -ErrorAction SilentlyContinue",
        "\"@",
        "",
        "Set-Content -Path $tempScript -Value $script -Encoding UTF8",
        "Start-Process powershell.exe -Verb RunAs -Wait -ArgumentList '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ('\"' + $tempScript + '\"')",
        "Remove-Item $tempScript -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "sing-box.exe",
    "persist": "config",
    "checkver": {
        "github": "https://github.com/reF1nd/sing-box-releases",
        "regex": "/releases/tag/v(?<version>\\d+\\.\\d+\\.\\d+-reF1nd(?:\\.\\d+)?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/reF1nd/sing-box-releases/releases/download/v$version/sing-box-$version-windows-amd64v3.zip",
                "extract_dir": "sing-box-$version-windows-amd64v3"
            }
        }
    }
}
