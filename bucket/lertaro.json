{
    "version": "5.7.5",
    "description": "A modern, high-performance local file search and productivity tool for Windows",
    "homepage": "https://github.com/Lertaro/Lertaro",
    "license": "MIT",
    "depends": "extras/windowsdesktop-runtime",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.7.5/Lertaro-Portable.zip",
            "hash": "21dd549214244a34cf12b10ad64d96774111fa7a5433942ff615c67c4765cf74"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.7.5/Lertaro-Portable-arm64.zip",
            "hash": "510ca449b7d01ed53139339644001a7a1e2d2ec0636dcfa160271511ce03fc7a"
        }
    },
    "extract_dir": "Lertaro",
    "bin": "lff.exe",
    "shortcuts": [
        [
            "Lertaro.App.exe",
            "Lertaro"
        ]
    ],
    "persist": "Data",
    "pre_uninstall": [
        "$processes = @(Get-Process 'Lertaro.App' -ErrorAction SilentlyContinue)",
        "foreach ($process in $processes) { $null = $process.CloseMainWindow() }",
        "if ($processes.Count -gt 0) { Start-Sleep -Seconds 2 }",
        "Get-Process 'Lertaro.App' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue"
    ],
    "notes": [
        "Lertaro requires the .NET 10 Desktop Runtime.",
        "Portable application data is persisted in the Data directory.",
        "If DOTNET_ROOT points to an older .NET SDK and Lertaro cannot detect .NET 10, set DOTNET_ROOT_X64 to C:\\Program Files\\dotnet."
    ],
    "checkver": {
        "github": "https://github.com/Lertaro/Lertaro"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Lertaro/Lertaro/releases/download/v$version/Lertaro-Portable-arm64.zip"
            }
        }
    }
}
