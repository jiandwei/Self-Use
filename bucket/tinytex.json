{
    "version": "2026.10",
    "description": "A lightweight and portable LaTeX distribution based on TeX Live.",
    "homepage": "https://yihui.org/tinytex/",
    "license": "GPL-2.0-or-later",
    "url": "https://github.com/rstudio/tinytex-releases/releases/download/v2026.10/TinyTeX-1-windows-v2026.10.exe#/dl.7z",
    "hash": "36c329c644683d981a668419d13c8804696e2816ae4d287ad755788fee231a31",
    "extract_dir": "TinyTeX",
    "env_add_path": "bin\\windows",
    "pre_install": [
        "$pkgCache = \"$persist_dir\\packages.txt\"",
        "if (Test-Path $pkgCache) {",
        "    $installed = @(& \"$dir\\bin\\windows\\tlmgr.bat\" info --list --only-installed --data name)",
        "    $wanted = @(Get-Content $pkgCache)",
        "    $missing = @($wanted | Where-Object { $_ -and $installed -notcontains $_ })",
        "    if ($missing.Count -gt 0) {",
        "        Write-Host \"Restoring TinyTeX packages...\"",
        "        $missing | ForEach-Object { & \"$dir\\bin\\windows\\tlmgr.bat\" install $_ }",
        "    }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if (Test-Path \"$dir\\bin\\windows\\tlmgr.bat\") {",
            "    New-Item -ItemType Directory -Force -Path $persist_dir | Out-Null",
            "    & \"$dir\\bin\\windows\\tlmgr.bat\" info --list --only-installed --data name | Set-Content \"$persist_dir\\packages.txt\"",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/rstudio/tinytex-releases"
    },
    "autoupdate": {
        "url": "https://github.com/rstudio/tinytex-releases/releases/download/v$version/TinyTeX-1-windows-v$version.exe#/dl.7z"
    }
}
