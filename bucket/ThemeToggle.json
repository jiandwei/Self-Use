{
    "version": "1.6.0",
    "description": "Windows light/dark theme switcher with automatic sunrise/sunset scheduling using Windows Location.",
    "homepage": "https://github.com/espensev/ThemeToggle",
    "license": "Unlicense",
    "url": "https://github.com/espensev/ThemeToggle/releases/download/v1.6.0/ThemeToggle-Portable.zip",
    "hash": "26C2C776CFAED41A9B8CD6C8E09C21CBE54AC2DE4D667BDD1176781CC647F9E7",
    "bin": "ThemeToggle.exe",
    "persist": "auto",
    "post_install": [
        "$script = @'",
        "#requires -version 5.1",
        "[CmdletBinding()]",
        "param(",
        "    [ValidateSet('Install','Refresh','Light','Dark','Status','Uninstall')]",
        "    [string]$Mode = 'Refresh',",
        "    [switch]$AllowLocationPrompt",
        ")",
        "",
        "$ErrorActionPreference = 'Stop'",
        "$TaskRefresh = 'ThemeToggle-SunCycle-Refresh'",
        "$TaskSunrise = 'ThemeToggle-Sunrise'",
        "$TaskSunset  = 'ThemeToggle-Sunset'",
        "$ThemeToggle = '__THEME_TOGGLE__'",
        "$ConfigPath  = Join-Path $PSScriptRoot 'config.json'",
        "$StatePath   = Join-Path $PSScriptRoot 'state.json'",
        "$LogPath     = Join-Path $PSScriptRoot 'ThemeAuto.log'",
        "",
        "function Write-Log([string]$Message) {",
        "    try { Add-Content -LiteralPath $LogPath -Encoding UTF8 -Value \"[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $Message\" } catch {}",
        "}",
        "",
        "function Get-Config {",
        "    if (-not (Test-Path -LiteralPath $ConfigPath)) { throw \"Config not found: $ConfigPath\" }",
        "    $c = Get-Content -LiteralPath $ConfigPath -Raw -Encoding UTF8 | ConvertFrom-Json",
        "    if ([string]$c.refreshTime -notmatch '^(?:[01]\\d|2[0-3]):[0-5]\\d$') { throw 'refreshTime must be HH:mm.' }",
        "    foreach ($p in 'locationTimeoutSeconds','sunriseOffsetMinutes','sunsetOffsetMinutes') {",
        "        if ($null -eq $c.$p) { throw \"Missing config value: $p\" }",
        "    }",
        "    return $c",
        "}",
        "",
        "function Get-WindowsLocation([int]$TimeoutSeconds, [bool]$AllowPrompt) {",
        "    Add-Type -AssemblyName System.Device",
        "    $w = New-Object System.Device.Location.GeoCoordinateWatcher",
        "    try {",
        "        $ok = $w.TryStart((-not $AllowPrompt), [TimeSpan]::FromSeconds($TimeoutSeconds))",
        "        if (-not $ok) { throw 'Windows Location timed out.' }",
        "        if ($w.Permission -eq [System.Device.Location.GeoPositionPermission]::Denied) { throw 'Windows Location permission denied.' }",
        "        $p = $w.Position.Location",
        "        if ($null -eq $p -or $p.IsUnknown) { throw 'Windows Location returned an unknown position.' }",
        "        if ($p.Latitude -lt -90 -or $p.Latitude -gt 90 -or $p.Longitude -lt -180 -or $p.Longitude -gt 180) {",
        "            throw 'Windows Location returned invalid coordinates.'",
        "        }",
        "        $accuracy = if ([double]::IsNaN([double]$p.HorizontalAccuracy) -or [double]::IsInfinity([double]$p.HorizontalAccuracy)) { $null } else { [double]$p.HorizontalAccuracy }",
        "        [pscustomobject]@{ Latitude=[double]$p.Latitude; Longitude=[double]$p.Longitude; HorizontalAccuracy=$accuracy }",
        "    }",
        "    finally {",
        "        try { $w.Stop() } catch {}",
        "        $w.Dispose()",
        "    }",
        "}",
        "",
        "function Get-SunData([double]$Latitude, [double]$Longitude) {",
        "    $ci = [Globalization.CultureInfo]::InvariantCulture",
        "    $lat = $Latitude.ToString('0.########', $ci)",
        "    $lng = $Longitude.ToString('0.########', $ci)",
        "    $uri = \"https://api.sunrise-sunset.org/v2?lat=$lat&lng=$lng\"",
        "    $d = Invoke-RestMethod -Uri $uri -Method Get -TimeoutSec 20 -Headers @{ 'User-Agent'='ThemeToggle-SunCycle/1.0' }",
        "    if ([string]::IsNullOrWhiteSpace([string]$d.sun_status)) { throw 'Invalid response from sunrise-sunset.org.' }",
        "    return $d",
        "}",
        "",
        "function Convert-SolarTime($Value) {",
        "    if ($null -eq $Value -or [string]::IsNullOrWhiteSpace([string]$Value)) { return $null }",
        "    return ([DateTimeOffset]::Parse([string]$Value)).ToLocalTime().DateTime",
        "}",
        "",
        "function Get-Principal {",
        "    New-ScheduledTaskPrincipal -UserId ([Security.Principal.WindowsIdentity]::GetCurrent().Name) -LogonType Interactive -RunLevel Limited",
        "}",
        "",
        "function Get-Settings {",
        "    New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries",
        "}",
        "",
        "function New-ScriptAction([ValidateSet('Refresh','Light','Dark')][string]$ActionMode) {",
        "    $ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
        "    if (-not (Test-Path -LiteralPath $ps)) { throw \"Windows PowerShell not found: $ps\" }",
        "    $args = \"-NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File `\"$PSCommandPath`\" -Mode $ActionMode\"",
        "    New-ScheduledTaskAction -Execute $ps -Argument $args",
        "}",
        "",
        "function Remove-SolarTasks {",
        "    $TaskSunrise,$TaskSunset | ForEach-Object {",
        "        Unregister-ScheduledTask -TaskName $_ -Confirm:$false -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "",
        "function Remove-AllTasks {",
        "    $TaskRefresh,$TaskSunrise,$TaskSunset | ForEach-Object {",
        "        Unregister-ScheduledTask -TaskName $_ -Confirm:$false -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "",
        "function Register-SolarTask([string]$TaskName, [datetime]$At, [ValidateSet('Light','Dark')][string]$ActionMode) {",
        "    if ($At -le (Get-Date).AddSeconds(10)) { return }",
        "    Register-ScheduledTask -TaskName $TaskName -Action (New-ScriptAction $ActionMode) `",
        "        -Trigger (New-ScheduledTaskTrigger -Once -At $At) -Principal (Get-Principal) `",
        "        -Settings (Get-Settings) -Description \"ThemeToggle automatic $ActionMode switch.\" -Force | Out-Null",
        "}",
        "",
        "function Register-RefreshTask {",
        "    $c = Get-Config",
        "    $parts = ([string]$c.refreshTime).Split(':')",
        "    $at = (Get-Date).Date.AddHours([int]$parts[0]).AddMinutes([int]$parts[1])",
        "    $user = [Security.Principal.WindowsIdentity]::GetCurrent().Name",
        "    $triggers = @(",
        "        (New-ScheduledTaskTrigger -Daily -At $at),",
        "        (New-ScheduledTaskTrigger -AtLogOn -User $user)",
        "    )",
        "    Register-ScheduledTask -TaskName $TaskRefresh -Action (New-ScriptAction Refresh) -Trigger $triggers `",
        "        -Principal (Get-Principal) -Settings (Get-Settings) `",
        "        -Description 'Recalculate sunrise/sunset daily and at logon.' -Force | Out-Null",
        "}",
        "",
        "function Set-Theme([ValidateSet('Light','Dark')][string]$Theme) {",
        "    if (-not (Test-Path -LiteralPath $ThemeToggle)) { throw \"ThemeToggle.exe not found: $ThemeToggle\" }",
        "    $arg = if ($Theme -eq 'Light') { '/light' } else { '/dark' }",
        "    & $ThemeToggle $arg '/quiet'",
        "    $code = $LASTEXITCODE",
        "    if ($code -notin 0,1,2) { throw \"ThemeToggle failed with exit code $code.\" }",
        "    $global:LASTEXITCODE = 0",
        "    Write-Log \"Applied $Theme theme.\"",
        "}",
        "",
        "function Save-State($Location, $Sun, $Sunrise, $Sunset, [string]$Theme) {",
        "    $state = [ordered]@{",
        "        updatedAt=(Get-Date).ToString('o')",
        "        latitude=$Location.Latitude",
        "        longitude=$Location.Longitude",
        "        horizontalAccuracy=$Location.HorizontalAccuracy",
        "        apiDate=[string]$Sun.date",
        "        apiTimeZone=[string]$Sun.tzid",
        "        sunStatus=[string]$Sun.sun_status",
        "        sunrise=$(if ($Sunrise) { $Sunrise.ToString('o') } else { $null })",
        "        sunset=$(if ($Sunset) { $Sunset.ToString('o') } else { $null })",
        "        appliedTheme=$Theme",
        "        solarDataSource='https://sunrise-sunset.org'",
        "    }",
        "    [IO.File]::WriteAllText($StatePath, ($state | ConvertTo-Json), (New-Object Text.UTF8Encoding($false)))",
        "}",
        "",
        "function Update-SolarSchedule([bool]$AllowPrompt) {",
        "    $c = Get-Config",
        "    $loc = Get-WindowsLocation ([int]$c.locationTimeoutSeconds) $AllowPrompt",
        "    $sun = Get-SunData $loc.Latitude $loc.Longitude",
        "",
        "    $rise = Convert-SolarTime $sun.sunrise",
        "    $set  = Convert-SolarTime $sun.sunset",
        "    if ($rise) { $rise = $rise.AddMinutes([double]$c.sunriseOffsetMinutes) }",
        "    if ($set)  { $set  = $set.AddMinutes([double]$c.sunsetOffsetMinutes) }",
        "",
        "    if ($sun.sun_status -eq 'normal' -and -not $rise -and -not $set) {",
        "        throw 'No sunrise/sunset returned for a normal solar day.'",
        "    }",
        "",
        "    Remove-SolarTasks",
        "",
        "    if ($sun.sun_status -eq 'midnight_sun') {",
        "        Set-Theme Light",
        "        Save-State $loc $sun $null $null 'Light'",
        "        return",
        "    }",
        "    if ($sun.sun_status -eq 'polar_night') {",
        "        Set-Theme Dark",
        "        Save-State $loc $sun $null $null 'Dark'",
        "        return",
        "    }",
        "",
        "    if ($rise) { Register-SolarTask $TaskSunrise $rise Light }",
        "    if ($set)  { Register-SolarTask $TaskSunset  $set  Dark }",
        "",
        "    $now = Get-Date",
        "    if ($rise -and $set) {",
        "        $theme = if ($now -ge $rise -and $now -lt $set) { 'Light' } else { 'Dark' }",
        "    } elseif (-not $rise -and $set) {",
        "        $theme = if ($now -lt $set) { 'Light' } else { 'Dark' }",
        "    } elseif ($rise -and -not $set) {",
        "        $theme = if ($now -lt $rise) { 'Dark' } else { 'Light' }",
        "    } else {",
        "        throw 'Unable to determine current solar state.'",
        "    }",
        "",
        "    Set-Theme $theme",
        "    Save-State $loc $sun $rise $set $theme",
        "    Write-Log \"Updated: lat=$($loc.Latitude), lon=$($loc.Longitude), rise=$rise, set=$set, theme=$theme\"",
        "}",
        "",
        "function Show-Status {",
        "    if (Test-Path -LiteralPath $StatePath) {",
        "        Get-Content -LiteralPath $StatePath -Raw -Encoding UTF8",
        "    } else {",
        "        'No state has been written yet.'",
        "    }",
        "    ''",
        "    'Solar data source: https://sunrise-sunset.org'",
        "    ''",
        "    'Scheduled tasks:'",
        "    Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object TaskName -Like 'ThemeToggle-*' | Select-Object TaskName,State",
        "}",
        "",
        "try {",
        "    switch ($Mode) {",
        "        'Install'   { Register-RefreshTask; Update-SolarSchedule $AllowLocationPrompt.IsPresent }",
        "        'Refresh'   { Update-SolarSchedule $AllowLocationPrompt.IsPresent }",
        "        'Light'     { Set-Theme Light }",
        "        'Dark'      { Set-Theme Dark }",
        "        'Status'    { Show-Status }",
        "        'Uninstall' { Remove-AllTasks; Write-Log 'Scheduled tasks removed.' }",
        "    }",
        "    exit 0",
        "} catch {",
        "    Write-Log \"ERROR: $($_.Exception.Message)\"",
        "    Write-Error $_",
        "    exit 1",
        "}",
        "'@",
        "$themePath = (Join-Path $dir 'ThemeToggle.exe').Replace(\"'\", \"''\")",
        "$script = $script.Replace('__THEME_TOGGLE__', $themePath)",
        "$autoDir = Join-Path $dir 'auto'",
        "$scriptPath = Join-Path $autoDir 'ThemeAuto.ps1'",
        "$utf8 = New-Object Text.UTF8Encoding($false)",
        "[IO.File]::WriteAllText($scriptPath, $script, $utf8)",
        "$configPath = Join-Path $autoDir 'config.json'",
        "if (-not (Test-Path -LiteralPath $configPath)) {",
        "    $config = [ordered]@{ refreshTime='00:05'; locationTimeoutSeconds=20; sunriseOffsetMinutes=0; sunsetOffsetMinutes=0 }",
        "    [IO.File]::WriteAllText($configPath, ($config | ConvertTo-Json), $utf8)",
        "}",
        "$ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
        "& $ps -NoProfile -ExecutionPolicy Bypass -File $scriptPath -Mode Install -AllowLocationPrompt",
        "if ($LASTEXITCODE -ne 0) { Write-Warning 'Automatic solar-theme setup could not complete. Enable Windows Location, then run ThemeAuto.ps1 -Mode Refresh -AllowLocationPrompt.' }"
    ],
    "pre_uninstall": [
        "$scriptPath = Join-Path $persist_dir 'auto\\ThemeAuto.ps1'",
        "$ps = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
        "if (Test-Path -LiteralPath $scriptPath) {",
        "    & $ps -NoProfile -ExecutionPolicy Bypass -File $scriptPath -Mode Uninstall",
        "} else {",
        "    'ThemeToggle-SunCycle-Refresh','ThemeToggle-Sunrise','ThemeToggle-Sunset' | ForEach-Object { Unregister-ScheduledTask -TaskName $_ -Confirm:$false -ErrorAction SilentlyContinue }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/espensev/ThemeToggle"
    },
    "autoupdate": {
        "url": "https://github.com/espensev/ThemeToggle/releases/download/v$version/ThemeToggle-Portable.zip"
    },
    "notes": [
        "Uses Windows Location only; no IP geolocation fallback.",
        "Solar data: https://sunrise-sunset.org",
        "Generated script: $dir\\auto\\ThemeAuto.ps1",
        "Config: $dir\\auto\\config.json",
        "If location access is disabled, enable Windows Settings > Privacy & security > Location, then run:",
        "powershell -ExecutionPolicy Bypass -File \"$dir\\auto\\ThemeAuto.ps1\" -Mode Refresh -AllowLocationPrompt",
        "Status:",
        "powershell -ExecutionPolicy Bypass -File \"$dir\\auto\\ThemeAuto.ps1\" -Mode Status"
    ]
}
