{
    "version": "1.6.0",
    "description": "Windows light/dark theme switcher with automatic sunrise/sunset scheduling using Windows Location.",
    "homepage": "https://github.com/espensev/ThemeToggle",
    "license": "Unlicense",
    "url": "https://github.com/espensev/ThemeToggle/releases/download/v1.6.0/ThemeToggle-Portable.zip",
    "hash": "26C2C776CFAED41A9B8CD6C8E09C21CBE54AC2DE4D667BDD1176781CC647F9E7",
    "bin": "ThemeToggle.exe",
    "persist": "auto",
    "post_install": [
        "$script = @'",
        "#requires -version 5.1",
        "[CmdletBinding()]",
        "param(",
        "    [ValidateSet('Install','Refresh','Light','Dark','Status','Uninstall')]",
        "    [string]$Mode = 'Refresh'",
        ")",
        "",
        "$ErrorActionPreference = 'Stop'",
        "",
        "$TaskRefresh = 'ThemeToggle-SunCycle-Refresh'",
        "$TaskSunrise = 'ThemeToggle-Sunrise'",
        "$TaskSunset  = 'ThemeToggle-Sunset'",
        "",
        "$ThemeToggle = '__THEME_TOGGLE__'",
        "$ConfigPath  = Join-Path $PSScriptRoot 'config.json'",
        "$StatePath   = Join-Path $PSScriptRoot 'state.json'",
        "$LogPath     = Join-Path $PSScriptRoot 'ThemeAuto.log'",
        "",
        "function Write-Log {",
        "    param([string]$Message)",
        "    try {",
        "        Add-Content -LiteralPath $LogPath -Encoding UTF8 -Value \"[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $Message\"",
        "    } catch {}",
        "}",
        "",
        "function Get-Config {",
        "    if (-not (Test-Path -LiteralPath $ConfigPath)) {",
        "        throw \"Config not found: $ConfigPath\"",
        "    }",
        "",
        "    $cfg = Get-Content -LiteralPath $ConfigPath -Raw -Encoding UTF8 | ConvertFrom-Json",
        "",
        "    if ([string]$cfg.refreshTime -notmatch '^(?:[01]\\d|2[0-3]):[0-5]\\d$') {",
        "        throw 'refreshTime must use HH:mm format.'",
        "    }",
        "",
        "    foreach ($name in @(",
        "        'locationTimeoutSeconds',",
        "        'maximumLocationAgeMinutes',",
        "        'sunriseOffsetMinutes',",
        "        'sunsetOffsetMinutes'",
        "    )) {",
        "        if ($null -eq $cfg.$name) {",
        "            throw \"Missing config value: $name\"",
        "        }",
        "    }",
        "",
        "    return $cfg",
        "}",
        "",
        "function ConvertFrom-WinRTAsync {",
        "    param(",
        "        [Parameter(Mandatory)]",
        "        $Operation,",
        "",
        "        [Parameter(Mandatory)]",
        "        [Type]$ResultType",
        "    )",
        "",
        "    Add-Type -AssemblyName System.Runtime.WindowsRuntime",
        "",
        "    $method = [System.WindowsRuntimeSystemExtensions].GetMethods() |",
        "        Where-Object {",
        "            $_.Name -eq 'AsTask' -and",
        "            $_.IsGenericMethodDefinition -and",
        "            $_.GetParameters().Count -eq 1 -and",
        "            $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1'",
        "        } |",
        "        Select-Object -First 1",
        "",
        "    if (-not $method) {",
        "        throw 'Could not locate WinRT AsTask<T>() helper.'",
        "    }",
        "",
        "    $task = $method.MakeGenericMethod($ResultType).Invoke($null, @($Operation))",
        "    return $task.GetAwaiter().GetResult()",
        "}",
        "",
        "function Get-WindowsLocation {",
        "    param(",
        "        [int]$TimeoutSeconds,",
        "        [int]$MaximumAgeMinutes",
        "    )",
        "",
        "    try {",
        "        Add-Type -AssemblyName System.Runtime.WindowsRuntime",
        "",
        "        # IMPORTANT: Windows PowerShell 5.1 requires these WinRT type literals",
        "        # to stay on one physical line.",
        "        $null = [Windows.Devices.Geolocation.Geolocator,Windows.Devices.Geolocation,ContentType=WindowsRuntime]",
        "        $null = [Windows.Devices.Geolocation.Geoposition,Windows.Devices.Geolocation,ContentType=WindowsRuntime]",
        "        $null = [Windows.Devices.Geolocation.PositionAccuracy,Windows.Devices.Geolocation,ContentType=WindowsRuntime]",
        "",
        "        $locator = [Windows.Devices.Geolocation.Geolocator,Windows.Devices.Geolocation,ContentType=WindowsRuntime]::new()",
        "        $locator.DesiredAccuracy = [Windows.Devices.Geolocation.PositionAccuracy,Windows.Devices.Geolocation,ContentType=WindowsRuntime]::Default",
        "",
        "        # Allows Windows to use coarse/obfuscated location where supported.",
        "        # The system-wide Location Services switch still needs to be enabled.",
        "        try {",
        "            $locator.AllowFallbackToConsentlessPositions()",
        "        } catch {",
        "            Write-Log \"AllowFallbackToConsentlessPositions unavailable: $($_.Exception.Message)\"",
        "        }",
        "",
        "        $maxAge = [TimeSpan]::FromMinutes($MaximumAgeMinutes)",
        "        $timeout = [TimeSpan]::FromSeconds($TimeoutSeconds)",
        "",
        "        $operation = $locator.GetGeopositionAsync($maxAge, $timeout)",
        "",
        "        $geoPositionType = [Windows.Devices.Geolocation.Geoposition,Windows.Devices.Geolocation,ContentType=WindowsRuntime]",
        "        $position = ConvertFrom-WinRTAsync -Operation $operation -ResultType $geoPositionType",
        "",
        "        if ($null -eq $position) {",
        "            throw 'Windows Geolocator returned no position.'",
        "        }",
        "",
        "        $coordinate = $position.Coordinate",
        "        $basic = $coordinate.Point.Position",
        "",
        "        $latitude = [double]$basic.Latitude",
        "        $longitude = [double]$basic.Longitude",
        "",
        "        if (",
        "            $latitude -lt -90 -or $latitude -gt 90 -or",
        "            $longitude -lt -180 -or $longitude -gt 180",
        "        ) {",
        "            throw \"Windows returned invalid coordinates: $latitude,$longitude\"",
        "        }",
        "",
        "        $accuracy = $null",
        "        try { $accuracy = [double]$coordinate.Accuracy } catch {}",
        "",
        "        $source = $null",
        "        try { $source = [string]$coordinate.PositionSource } catch {}",
        "",
        "        Write-Log (\"Windows location: lat={0}, lon={1}, accuracy={2}, source={3}\" -f $latitude, $longitude, $accuracy, $source)",
        "",
        "        return [pscustomobject]@{",
        "            Latitude = $latitude",
        "            Longitude = $longitude",
        "            HorizontalAccuracy = $accuracy",
        "            PositionSource = $source",
        "        }",
        "    }",
        "    catch {",
        "        throw @\"",
        "Windows Location Services could not provide a position.",
        "",
        "$($_.Exception.Message)",
        "",
        "Open:",
        "  Settings -> Privacy & security -> Location",
        "",
        "Make sure Location services is enabled.",
        "For a desktop PC, configuring Default location may also help.",
        "",
        "Open the Location settings page with:",
        "  start ms-settings:privacy-location",
        "\"@",
        "    }",
        "}",
        "",
        "function Get-SunData {",
        "    param(",
        "        [double]$Latitude,",
        "        [double]$Longitude",
        "    )",
        "",
        "    $culture = [Globalization.CultureInfo]::InvariantCulture",
        "    $lat = $Latitude.ToString('0.########', $culture)",
        "    $lng = $Longitude.ToString('0.########', $culture)",
        "    $uri = \"https://api.sunrise-sunset.org/v2?lat=$lat&lng=$lng\"",
        "",
        "    try {",
        "        $data = Invoke-RestMethod -Uri $uri -Method Get -TimeoutSec 20 -Headers @{ 'User-Agent' = 'ThemeToggle-SunCycle/2.0' }",
        "",
        "        if ([string]::IsNullOrWhiteSpace([string]$data.sun_status)) {",
        "            throw 'The API response does not contain sun_status.'",
        "        }",
        "",
        "        return $data",
        "    }",
        "    catch {",
        "        throw \"Unable to query sunrise-sunset.org: $($_.Exception.Message)\"",
        "    }",
        "}",
        "",
        "function Convert-SolarTime {",
        "    param($Value)",
        "",
        "    if ($null -eq $Value -or [string]::IsNullOrWhiteSpace([string]$Value)) {",
        "        return $null",
        "    }",
        "",
        "    return ([DateTimeOffset]::Parse([string]$Value, [Globalization.CultureInfo]::InvariantCulture)).ToLocalTime().DateTime",
        "}",
        "",
        "function Get-TaskPrincipal {",
        "    $user = [Security.Principal.WindowsIdentity]::GetCurrent().Name",
        "    return New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Limited",
        "}",
        "",
        "function Get-TaskSettings {",
        "    return New-ScheduledTaskSettingsSet -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries",
        "}",
        "",
        "function New-ScriptAction {",
        "    param(",
        "        [ValidateSet('Refresh','Light','Dark')]",
        "        [string]$ActionMode",
        "    )",
        "",
        "    $powershell = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
        "",
        "    if (-not (Test-Path -LiteralPath $powershell)) {",
        "        throw \"Windows PowerShell not found: $powershell\"",
        "    }",
        "",
        "    $arguments = @(",
        "        '-NoProfile'",
        "        '-NonInteractive'",
        "        '-WindowStyle Hidden'",
        "        '-ExecutionPolicy Bypass'",
        "        \"-File `\"$PSCommandPath`\"\"",
        "        \"-Mode $ActionMode\"",
        "    ) -join ' '",
        "",
        "    return New-ScheduledTaskAction -Execute $powershell -Argument $arguments",
        "}",
        "",
        "function Remove-SolarTasks {",
        "    foreach ($task in @($TaskSunrise, $TaskSunset)) {",
        "        Unregister-ScheduledTask -TaskName $task -Confirm:$false -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "",
        "function Remove-AllTasks {",
        "    foreach ($task in @($TaskRefresh, $TaskSunrise, $TaskSunset)) {",
        "        Unregister-ScheduledTask -TaskName $task -Confirm:$false -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "",
        "function Register-SolarTask {",
        "    param(",
        "        [string]$TaskName,",
        "        [datetime]$At,",
        "",
        "        [ValidateSet('Light','Dark')]",
        "        [string]$ActionMode",
        "    )",
        "",
        "    if ($At -le (Get-Date).AddSeconds(10)) {",
        "        return",
        "    }",
        "",
        "    Register-ScheduledTask `",
        "        -TaskName $TaskName `",
        "        -Action (New-ScriptAction $ActionMode) `",
        "        -Trigger (New-ScheduledTaskTrigger -Once -At $At) `",
        "        -Principal (Get-TaskPrincipal) `",
        "        -Settings (Get-TaskSettings) `",
        "        -Description \"ThemeToggle automatic $ActionMode switch.\" `",
        "        -Force | Out-Null",
        "}",
        "",
        "function Register-RefreshTask {",
        "    $cfg = Get-Config",
        "    $parts = ([string]$cfg.refreshTime).Split(':')",
        "",
        "    # Keep method chaining on one line for Windows PowerShell 5.1.",
        "    $at = (Get-Date).Date.AddHours([int]$parts[0]).AddMinutes([int]$parts[1])",
        "",
        "    $user = [Security.Principal.WindowsIdentity]::GetCurrent().Name",
        "",
        "    $triggers = @(",
        "        (New-ScheduledTaskTrigger -Daily -At $at),",
        "        (New-ScheduledTaskTrigger -AtLogOn -User $user)",
        "    )",
        "",
        "    Register-ScheduledTask `",
        "        -TaskName $TaskRefresh `",
        "        -Action (New-ScriptAction Refresh) `",
        "        -Trigger $triggers `",
        "        -Principal (Get-TaskPrincipal) `",
        "        -Settings (Get-TaskSettings) `",
        "        -Description 'Recalculate sunrise/sunset daily and at logon.' `",
        "        -Force | Out-Null",
        "}",
        "",
        "function Set-Theme {",
        "    param(",
        "        [ValidateSet('Light','Dark')]",
        "        [string]$Theme",
        "    )",
        "",
        "    if (-not (Test-Path -LiteralPath $ThemeToggle)) {",
        "        throw \"ThemeToggle.exe not found: $ThemeToggle\"",
        "    }",
        "",
        "    if ($Theme -eq 'Light') {",
        "        & $ThemeToggle '/light' '/quiet'",
        "    } else {",
        "        & $ThemeToggle '/dark' '/quiet'",
        "    }",
        "",
        "    Write-Log \"Applied $Theme theme.\"",
        "}",
        "",
        "function Save-State {",
        "    param(",
        "        $Location,",
        "        $Sun,",
        "        $Sunrise,",
        "        $Sunset,",
        "        [string]$Theme",
        "    )",
        "",
        "    $state = [ordered]@{",
        "        updatedAt = (Get-Date).ToString('o')",
        "        latitude = $Location.Latitude",
        "        longitude = $Location.Longitude",
        "        horizontalAccuracy = $Location.HorizontalAccuracy",
        "        positionSource = $Location.PositionSource",
        "        apiDate = [string]$Sun.date",
        "        apiTimeZone = [string]$Sun.tzid",
        "        utcOffset = [string]$Sun.utc_offset",
        "        sunStatus = [string]$Sun.sun_status",
        "        sunrise = if ($Sunrise) { $Sunrise.ToString('o') } else { $null }",
        "        sunset = if ($Sunset) { $Sunset.ToString('o') } else { $null }",
        "        appliedTheme = $Theme",
        "        solarDataSource = 'https://sunrise-sunset.org'",
        "    }",
        "",
        "    [IO.File]::WriteAllText(",
        "        $StatePath,",
        "        ($state | ConvertTo-Json),",
        "        (New-Object Text.UTF8Encoding($false))",
        "    )",
        "}",
        "",
        "function Update-SolarSchedule {",
        "    $cfg = Get-Config",
        "",
        "    $location = Get-WindowsLocation `",
        "        -TimeoutSeconds ([int]$cfg.locationTimeoutSeconds) `",
        "        -MaximumAgeMinutes ([int]$cfg.maximumLocationAgeMinutes)",
        "",
        "    $sun = Get-SunData -Latitude $location.Latitude -Longitude $location.Longitude",
        "",
        "    $sunrise = Convert-SolarTime $sun.sunrise",
        "    $sunset  = Convert-SolarTime $sun.sunset",
        "",
        "    if ($sunrise) {",
        "        $sunrise = $sunrise.AddMinutes([double]$cfg.sunriseOffsetMinutes)",
        "    }",
        "",
        "    if ($sunset) {",
        "        $sunset = $sunset.AddMinutes([double]$cfg.sunsetOffsetMinutes)",
        "    }",
        "",
        "    Remove-SolarTasks",
        "",
        "    switch ([string]$sun.sun_status) {",
        "        'midnight_sun' {",
        "            Set-Theme Light",
        "            Save-State $location $sun $null $null 'Light'",
        "            Write-Log 'Solar status is midnight_sun; using Light theme.'",
        "            return",
        "        }",
        "",
        "        'polar_night' {",
        "            Set-Theme Dark",
        "            Save-State $location $sun $null $null 'Dark'",
        "            Write-Log 'Solar status is polar_night; using Dark theme.'",
        "            return",
        "        }",
        "",
        "        'normal' {",
        "            # v2 can legally return only sunrise or only sunset near polar circles.",
        "        }",
        "",
        "        default {",
        "            throw \"Unknown sun_status returned by API: $($sun.sun_status)\"",
        "        }",
        "    }",
        "",
        "    if ($sunrise) {",
        "        Register-SolarTask -TaskName $TaskSunrise -At $sunrise -ActionMode Light",
        "    }",
        "",
        "    if ($sunset) {",
        "        Register-SolarTask -TaskName $TaskSunset -At $sunset -ActionMode Dark",
        "    }",
        "",
        "    $now = Get-Date",
        "",
        "    if ($sunrise -and $sunset) {",
        "        $theme = if ($now -ge $sunrise -and $now -lt $sunset) { 'Light' } else { 'Dark' }",
        "    }",
        "    elseif ($sunrise -and -not $sunset) {",
        "        # Before today's sunrise it is dark; after it rises there is no sunset today.",
        "        $theme = if ($now -lt $sunrise) { 'Dark' } else { 'Light' }",
        "    }",
        "    elseif (-not $sunrise -and $sunset) {",
        "        # The sun was already up at local midnight; it remains light until sunset.",
        "        $theme = if ($now -lt $sunset) { 'Light' } else { 'Dark' }",
        "    }",
        "    else {",
        "        throw 'sun_status=normal but neither sunrise nor sunset was returned.'",
        "    }",
        "",
        "    Set-Theme $theme",
        "    Save-State $location $sun $sunrise $sunset $theme",
        "",
        "    $riseText = if ($sunrise) { $sunrise.ToString('yyyy-MM-dd HH:mm:ss') } else { '<none>' }",
        "    $setText  = if ($sunset)  { $sunset.ToString('yyyy-MM-dd HH:mm:ss') } else { '<none>' }",
        "",
        "    Write-Log \"Schedule updated: sunrise=$riseText, sunset=$setText, theme=$theme\"",
        "}",
        "",
        "function Show-Status {",
        "    if (Test-Path -LiteralPath $StatePath) {",
        "        Get-Content -LiteralPath $StatePath -Raw -Encoding UTF8",
        "    } else {",
        "        Write-Output 'No state.json exists yet.'",
        "    }",
        "",
        "    Write-Output ''",
        "    Write-Output 'Scheduled tasks:'",
        "",
        "    Get-ScheduledTask -ErrorAction SilentlyContinue |",
        "        Where-Object { $_.TaskName -like 'ThemeToggle-*' } |",
        "        Select-Object TaskName, State",
        "}",
        "",
        "try {",
        "    switch ($Mode) {",
        "        'Install' {",
        "            Register-RefreshTask",
        "            Update-SolarSchedule",
        "        }",
        "",
        "        'Refresh' {",
        "            Update-SolarSchedule",
        "        }",
        "",
        "        'Light' {",
        "            Set-Theme Light",
        "        }",
        "",
        "        'Dark' {",
        "            Set-Theme Dark",
        "        }",
        "",
        "        'Status' {",
        "            Show-Status",
        "        }",
        "",
        "        'Uninstall' {",
        "            Remove-AllTasks",
        "            Write-Log 'Scheduled tasks removed.'",
        "        }",
        "    }",
        "",
        "    exit 0",
        "}",
        "catch {",
        "    Write-Log \"ERROR: $($_.Exception.Message)\"",
        "    Write-Error $_",
        "    exit 1",
        "}",
        "'@",
        "$autoDir = Join-Path $persist_dir 'auto'",
        "New-Item -ItemType Directory -Force -Path $autoDir | Out-Null",
        "$scriptPath = Join-Path $autoDir 'ThemeAuto.ps1'",
        "$configPath = Join-Path $autoDir 'config.json'",
        "$themePath = (Join-Path $dir 'ThemeToggle.exe').Replace(\"'\", \"''\")",
        "$script = $script.Replace('__THEME_TOGGLE__', $themePath)",
        "$utf8 = New-Object Text.UTF8Encoding($false)",
        "[IO.File]::WriteAllText($scriptPath, $script, $utf8)",
        "if (-not (Test-Path -LiteralPath $configPath)) {",
        "    $config = [ordered]@{ refreshTime='00:05'; locationTimeoutSeconds=30; maximumLocationAgeMinutes=15; sunriseOffsetMinutes=0; sunsetOffsetMinutes=0 }",
        "    [IO.File]::WriteAllText($configPath, ($config | ConvertTo-Json), $utf8)",
        "}",
        "$powershell = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
        "& $powershell -NoProfile -ExecutionPolicy Bypass -File $scriptPath -Mode Install",
        "if ($LASTEXITCODE -ne 0) {",
        "    Write-Warning 'Solar-theme initialization failed. The refresh task is installed; enable Windows Location and run ThemeAuto.ps1 -Mode Refresh.'",
        "}"
    ],
    "pre_uninstall": [
        "$scriptPath = Join-Path $persist_dir 'auto\\ThemeAuto.ps1'",
        "$powershell = Join-Path $env:SystemRoot 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
        "if (Test-Path -LiteralPath $scriptPath) {",
        "    & $powershell -NoProfile -ExecutionPolicy Bypass -File $scriptPath -Mode Uninstall",
        "} else {",
        "    'ThemeToggle-SunCycle-Refresh','ThemeToggle-Sunrise','ThemeToggle-Sunset' | ForEach-Object {",
        "        Unregister-ScheduledTask -TaskName $_ -Confirm:$false -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/espensev/ThemeToggle"
    },
    "autoupdate": {
        "url": "https://github.com/espensev/ThemeToggle/releases/download/v$version/ThemeToggle-Portable.zip"
    },
    "notes": [
        "Uses Windows.Devices.Geolocation.Geolocator; no IP geolocation is used.",
        "Uses coarse Windows location fallback when supported.",
        "Sunrise/sunset source: https://sunrise-sunset.org",
        "Script: $persist_dir\\auto\\ThemeAuto.ps1",
        "Config: $persist_dir\\auto\\config.json",
        "Open Location settings: start ms-settings:privacy-location",
        "Refresh manually: powershell -ExecutionPolicy Bypass -File \"$persist_dir\\auto\\ThemeAuto.ps1\" -Mode Refresh",
        "Show status: powershell -ExecutionPolicy Bypass -File \"$persist_dir\\auto\\ThemeAuto.ps1\" -Mode Status"
    ]
}
