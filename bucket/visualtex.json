            "hash": "8c45c4aa5af90a1ace428cc1717335346336881d61cad6cc0b27da9a24da3575"
        }
    },
    "pre_install": [
        "$exe = Get-ChildItem -LiteralPath $dir -Filter 'visualtex.exe' -File -Recurse | Select-Object -First 1",
        "if (-not $exe) { throw 'visualtex.exe was not found in the extracted NSIS package.' }",
        "if ($exe.Directory.FullName -ne $dir) {",
        "    Get-ChildItem -LiteralPath $exe.Directory.FullName -Force | Move-Item -Destination $dir -Force",
        "}"
    ],
    "bin": "visualtex.exe",
    "checkver": {
        "github": "https://github.com/paulhe666/visualtex"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/paulhe666/visualtex/releases/download/v$version/VisualTeX_$version_x64-no-ocr-setup.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "仅使用 7-Zip 解包官方 NSIS 安装包；不执行安装、卸载、Office 插件注册或自动创建开始菜单快捷方式。",
        "注意：这并非完全纯绿色版。VisualTeX v1.2.7 启动时仍会写入 HKCU\\Software\\VisualTeX\\OfficeIntegration，并可能向用户 AppData 写入配置和 WebView 数据；Scoop manifest 无法禁止这些行为。",
        "若要求无注册表和用户目录写入，必须由上游程序增加便携模式并重新编译；本 manifest 不会伪称支持这一能力。",
        "无本地 OCR 资源，支持在线/API OCR。"
    ]
}
